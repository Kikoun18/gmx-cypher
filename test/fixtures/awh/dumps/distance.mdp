integrator = md
nsteps = 0
dt = 0.002
cutoff-scheme = verlet
nstcalcenergy = 10
nstenergy = 100
coulombtype = cut-off
rcoulomb = 1.0
rvdw = 1.0
pbc = xyz
pull = yes
pull-ngroups = 2
pull-group1-name = g1
pull-group2-name = g2
pull-ncoords = 1
pull-coord1-type = external-potential
pull-coord1-potential-provider = awh
pull-coord1-geometry = distance
pull-coord1-groups = 1 2
awh = yes
awh-nstout = 100
awh-nbias = 1
awh1-ndim = 1
awh1-dim1-coord-provider = pull
awh1-dim1-coord-index = 1
awh1-dim1-start = 0.3
awh1-dim1-end = 0.8
awh1-dim1-force-constant = 100
awh1-dim1-diffusion = 1e-5
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
