integrator = md
nsteps = 0
dt = 0.002
cutoff-scheme = verlet
nstcalcenergy = 10
nstenergy = 100
coulombtype = cut-off
rcoulomb = 1.0
rvdw = 1.0
pbc = xyz
free-energy = yes
init-lambda-state = 0
fep-lambdas = 0 0.5 1
nstdhdl = 0
calc-lambda-neighbors = -1
awh = yes
awh-nstout = 100
awh-nbias = 1
awh1-ndim = 1
awh1-dim1-coord-provider = fep-lambda
awh1-dim1-start = 0
awh1-dim1-end = 2

awh1-dim1-diffusion = 1e-3
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
awh-potential = umbrella
