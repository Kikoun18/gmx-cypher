{
  "analyses": [
    {
      "k": "hist",
      "label": "Histogram",
      "match": "histogram, histo, umbrella",
      "name": "Umbrella / AWH sampling histograms",
      "style": "step",
      "xCol": 1,
      "xLabel": "Reaction coordinate (nm)",
      "xScale": 1,
      "yCols": "all",
      "yLabel": "Count"
    },
    {
      "k": "rdf",
      "label": "RDF",
      "marker": "max",
      "markerLabel": "y",
      "match": "rdf, radial",
      "name": "Radial distribution function",
      "style": "line",
      "xCol": 1,
      "xLabel": "r (nm)",
      "xScale": 1,
      "yCols": "2",
      "yLabel": "g(r)"
    },
    {
      "k": "rmsd",
      "label": "RMSD",
      "match": "rmsd",
      "name": "Root-mean-square deviation",
      "style": "line",
      "xCol": 1,
      "xLabel": "Time (ps)",
      "xScale": 1,
      "yCols": "2",
      "yLabel": "RMSD (nm)"
    },
    {
      "k": "rmsf",
      "label": "RMSF",
      "match": "rmsf, fluctuation",
      "name": "Per-residue fluctuation",
      "style": "line",
      "xCol": 1,
      "xLabel": "Residue",
      "xScale": 1,
      "yCols": "2",
      "yLabel": "RMSF (nm)"
    },
    {
      "k": "rg",
      "label": "Rg",
      "match": "gyrate, gyration, rg",
      "name": "Radius of gyration",
      "style": "line",
      "xCol": 1,
      "xLabel": "Time (ps)",
      "xScale": 1,
      "yCols": "2",
      "yLabel": "Rg (nm)"
    },
    {
      "k": "hbond",
      "label": "H-bonds",
      "match": "hbond, hbnum, hydrogen",
      "name": "Hydrogen bonds",
      "style": "line",
      "xCol": 1,
      "xLabel": "Time (ps)",
      "xScale": 1,
      "yCols": "2",
      "yLabel": "Number"
    },
    {
      "k": "dist",
      "label": "Distance",
      "match": "distance, pullx",
      "name": "COM distance",
      "style": "line",
      "xCol": 1,
      "xLabel": "Time (ps)",
      "xScale": 1,
      "yCols": "2",
      "yLabel": "Distance (nm)"
    },
    {
      "k": "energy",
      "label": "Energy",
      "match": "energy",
      "name": "Energy terms",
      "style": "line",
      "xCol": 1,
      "xLabel": "Time (ps)",
      "xScale": 1,
      "yCols": "all",
      "yLabel": "kJ/mol"
    }
  ]
}
